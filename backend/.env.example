# Optional local SQLite file. Relative paths are resolved from backend/.
# RESOLVE_DATABASE_PATH=data/resolve.sqlite3

# PayPal reads remain disabled until you configure all fields locally.
RESOLVE_PAYPAL_SANDBOX_ENABLED=false
# Separate opt-in for approved first full-capture sandbox refunds:
RESOLVE_PAYPAL_SANDBOX_REFUNDS_ENABLED=false
# Resolve merchant UUID from create-merchant / GET /auth/me:
# RESOLVE_PAYPAL_RESOLVE_MERCHANT_ID=
# Sandbox REST app credentials; these are not your sandbox login password:
# RESOLVE_PAYPAL_SANDBOX_CLIENT_ID=
# RESOLVE_PAYPAL_SANDBOX_CLIENT_SECRET=
# PayPal sandbox seller's merchant ID; distinct from the Resolve UUID:
# RESOLVE_PAYPAL_SANDBOX_MERCHANT_ID=
