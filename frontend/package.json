{
  "name": "resolve-merchant-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run docs:export && next build",
    "docs:export": "node scripts/export-docs.mjs",
    "docs:check": "node scripts/export-docs.mjs --check",
    "build:preview": "npm run docs:export && node scripts/preview.mjs build",
    "preview": "node scripts/preview.mjs start",
    "start": "next start --hostname 127.0.0.1",
    "start:hosted": "next start --hostname 0.0.0.0",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
