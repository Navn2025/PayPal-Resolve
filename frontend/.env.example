# Default for a co-located FastAPI backend. For separate services, use its
# HTTPS origin or opt in to a trusted private-network HTTP endpoint.
RESOLVE_BACKEND_URL=http://127.0.0.1:8000
# RESOLVE_BACKEND_ALLOW_PRIVATE_HTTP=true
# Exact public merchant origin, matching backend settings and PayPal callback.
# RESOLVE_MERCHANT_WEB_ORIGIN=https://resolve.example.com
# Optional: set the same exact HTTPS customer origin as the backend.
# RESOLVE_CUSTOMER_PUBLIC_ORIGIN=https://support.example.com
