# Optional local SQLite file. Relative paths are resolved from backend/.
# RESOLVE_DATABASE_PATH=data/resolve.sqlite3
# Optional: use PostgreSQL for FastAPI, the merchant CLI, and both workers.
# Keep the real URL in backend/.env only. Use TLS options from your provider.
# RESOLVE_DATABASE_URL=postgresql://ROLE:PASSWORD@HOST/DATABASE?sslmode=require

# Browser sign-in (optional PayPal identity flow; separate from payment credentials).
# Set the same hosted merchant origin on the frontend.
# RESOLVE_MERCHANT_WEB_ORIGIN=https://resolve.example.com
RESOLVE_PAYPAL_LOGIN_ENABLED=false
RESOLVE_PAYPAL_LOGIN_ENVIRONMENT=sandbox
# RESOLVE_PAYPAL_LOGIN_CLIENT_ID=
# RESOLVE_PAYPAL_LOGIN_CLIENT_SECRET=

# PayPal reads remain disabled until you configure all fields locally.
RESOLVE_PAYPAL_SANDBOX_ENABLED=false
# Separate opt-in for approved sandbox refunds:
RESOLVE_PAYPAL_SANDBOX_REFUNDS_ENABLED=false
# Also require fresh, verified order history and allow partial/multiple refunds:
RESOLVE_PAYPAL_SANDBOX_PARTIAL_REFUNDS_ENABLED=false
# Webhook ID issued by the same Sandbox REST app when registering the HTTPS URL:
# RESOLVE_PAYPAL_SANDBOX_WEBHOOK_ID=
# Resolve merchant UUID from create-merchant / GET /auth/me:
# RESOLVE_PAYPAL_RESOLVE_MERCHANT_ID=
# Sandbox REST app credentials; these are not your sandbox login password:
# RESOLVE_PAYPAL_SANDBOX_CLIENT_ID=
# RESOLVE_PAYPAL_SANDBOX_CLIENT_SECRET=
# PayPal sandbox seller's merchant ID; distinct from the Resolve UUID:
# RESOLVE_PAYPAL_SANDBOX_MERCHANT_ID=

# Optional read-only resolution evidence connectors, restricted to one Resolve merchant:
# RESOLVE_RESOLUTION_CONNECTOR_MERCHANT_ID=
# RESOLVE_SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# RESOLVE_SHOPIFY_ADMIN_TOKEN=
# RESOLVE_EASYPOST_API_KEY=
RESOLVE_AUTO_PROVIDER_REFRESH_ENABLED=false

# Optional transactional email and My cases. Use a public HTTPS customer origin.
RESOLVE_CUSTOMER_EMAIL_ENABLED=false
# RESOLVE_CUSTOMER_EMAIL_MERCHANT_ID=
# RESOLVE_CUSTOMER_PUBLIC_ORIGIN=https://support.example.com
# RESOLVE_CUSTOMER_SIGNING_KEY=
# RESOLVE_RESEND_API_KEY=
# RESOLVE_RESEND_FROM=updates@example.com

# Optional read-only Zendesk connection, scoped to one merchant:
# RESOLVE_HELPDESK_MERCHANT_ID=
# RESOLVE_ZENDESK_SUBDOMAIN=
# RESOLVE_ZENDESK_OAUTH_TOKEN=
